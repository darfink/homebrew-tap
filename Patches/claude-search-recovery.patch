+}
+
+func TestClaudeSearchGenericRecoverySplitCallsAndCitations(t *testing.T) {
+	body := []byte(`{"messages":[{"role":"system","content":[{"type":"text","text":"ordinary instructions"}]},{"role":"assistant","content":[{"type":"server_tool_use","id":"srvtoolu_split","name":"web_search","input":{"query":"split search"}},{"type":"web_search_tool_result","tool_use_id":"srvtoolu_split","content":[]}]},{"role":"user","content":"ordinary followup"},{"role":"assistant","content":[{"type":"text","text":"Preserve this answer","citations":[{"type":"web_search_result_location","encrypted_index":"split-opaque-index","url":"https://split.example","cited_text":"split source excerpt"}]}]}]}`)
+	// The real failure referred to block 19 even though this citation occupies
+	// block 0, in a different assistant message from its search call and result.
+	for _, message := range []string{
+		"messages.33.content.19.citations.0: Invalid `encrypted_index` in `text` block",
+		"messages.0.content.500.citations.999: Invalid `encrypted_index` in `text` block",
+		"Invalid `encrypted_index` in `text` block",
+		"Failed to decrypt web search result content",
+	} {
+		t.Run(message, func(t *testing.T) {
+			recovered, changed := RecoverClaudeSearchHistory(body, citationRecoveryFailure(message))
+			if !changed || strings.Contains(string(recovered), "split-opaque-index") || strings.Contains(string(recovered), `"web_search_tool_result"`) {
+				t.Fatal("split hosted-search history did not recover")
+			}
+			for _, want := range []string{"split search", "Preserve this answer", "https://split.example", "split source excerpt"} {
+				if !strings.Contains(string(recovered), want) {
+					t.Errorf("lost readable history %q", want)
+				}
+			}
+			for _, path := range []string{"messages.0", "messages.2"} {
+				if gjson.GetBytes(body, path).Raw != gjson.GetBytes(recovered, path).Raw {
+					t.Errorf("changed ordinary history %s", path)
+				}
+			}
+		})
+	}
+}
+
+func TestClaudeSearchGenericRecoveryDoesNotRequireUniqueIDs(t *testing.T) {
+	body := []byte(`{"messages":[{"role":"assistant","content":[{"type":"server_tool_use","name":"web_search","id":"same","input":{"query":"one"}},{"type":"web_search_tool_result","tool_use_id":"same","content":[{"url":"https://one.example","encrypted_content":"one-secret"}]},{"type":"text","text":"One","citations":[{"type":"web_search_result_location","encrypted_index":"one-index","url":"https://one.example","cited_text":"one excerpt"}]},{"type":"server_tool_use","name":"web_search","id":"same","input":{"query":"two"}},{"type":"web_search_tool_result","tool_use_id":"same","content":[{"url":"https://two.example","encrypted_content":"two-secret"}]},{"type":"text","text":"Two","citations":[{"type":"web_search_result_location","encrypted_index":"two-index","url":"https://two.example","cited_text":"two excerpt"}]},{"type":"server_tool_use","name":"web_search","input":{"query":"missing id"}},{"type":"web_search_tool_result","content":[{"url":"https://three.example","encrypted_content":"three-secret"}]}]}]}`)
+	failure := citationRecoveryFailure("messages.1.content.2.citations.0: Invalid `encrypted_index` in `text` block")
+	recovered, changed := RecoverClaudeSearchHistory(body, failure)
+	if !changed {
+		t.Fatal("duplicate and missing hosted-search IDs prevented recovery")
+	}
+	for _, secret := range []string{"one-secret", "two-secret", "three-secret", "one-index", "two-index"} {
+		if strings.Contains(string(recovered), secret) {
+			t.Errorf("recovered history retained opaque value %q", secret)
+		}
+	}
+	for _, readable := range []string{"https://one.example", "one excerpt", "https://two.example", "two excerpt", "https://three.example"} {
+		if !strings.Contains(string(recovered), readable) {
+			t.Errorf("recovered history lost reference %q", readable)
+		}
+	}
+}
+
+func TestClaudeSearchGenericRecoveryPreservesUnrelatedRawFieldsAndCitations(t *testing.T) {
+	body := []byte(genericSearchRecoveryFixture)
+	failure := citationRecoveryFailure("Failed to decrypt web search result content")
+	recovered, changed := RecoverClaudeSearchHistory(body, failure)
+	if !changed {
+		t.Fatal("expected hosted search history to recover")
+	}
+	for _, path := range []string{"model", "system", "messages.0", "messages.1.content.0", "messages.1.content.3.cache_control", "messages.2.content.2", "messages.2.content.3", "messages.2.content.4", "messages.2.content.5", "messages.3"} {
+		if original, got := gjson.GetBytes(body, path).Raw, gjson.GetBytes(recovered, path).Raw; original != got {
+			t.Errorf("unrelated raw field %s changed: original %s, got %s", path, original, got)
+		}
+	}
+	for _, path := range []string{"messages.1.content.3.citations", "messages.2.content.6.citations"} {
+		if got := gjson.GetBytes(recovered, path+".0").Raw; got == "" || got != gjson.GetBytes(body, path+".1").Raw {
+			t.Errorf("document citation at %s was not preserved: %s", path, got)
+		}
+	}
+}
+
+func TestClaudeSearchGenericRecoveryIsDeterministicAndRetryIsSingleUse(t *testing.T) {
+	body := []byte(genericSearchRecoveryFixture)
+	failure := citationRecoveryFailure("messages.999.content.999.citations.999: Invalid `encrypted_content` in `search_result` block")
+	first, changed := RecoverClaudeSearchHistory(body, failure)
+	if !changed {
+		t.Fatal("expected generic recovery")
+	}
+	second, changed := RecoverClaudeSearchHistory(body, failure)
+	if !changed || !bytes.Equal(first, second) {
+		t.Fatal("recovery output was not deterministic")
+	}
+	if _, changed := RecoverClaudeSearchHistory(first, failure); changed {
+		t.Fatal("already rendered history was changed a second time")
+	}
+	ctx := WithClaudeSearchRecovery(context.Background(), failure, body)
+	if got := ApplyClaudeSearchRecovery(ctx, body); !bytes.Equal(got, first) {
+		t.Fatal("context recovery differed from direct recovery")
+	}
+	if CanRecoverClaudeSearch(ctx, failure) {
+		t.Fatal("same rejection remained eligible for another retry")
+	}
+	if CanRecoverClaudeSearch(ctx, citationRecoveryFailure("unrelated model validation error")) {
+		t.Fatal("recovery context authorized retry for unrelated error")
+	}
+	unmarked := ApplyClaudeSearchRecovery(context.Background(), body)
+	if !bytes.Equal(unmarked, body) {
+		t.Fatal("unmarked context changed happy-path request")
+	}
+}
