+package helps
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+const genericSearchRecoveryFixture = `{"model":"claude-opus-5-5","system":[{"type":"text","text":"keep root","cache_control":{"type":"ephemeral"}}],"messages":[{"role":"user","content":"question"},{"role":"assistant","content":[{"type":"thinking","thinking":"preserve thought","signature":"sig"},{"type":"server_tool_use","id":"search-a","name":"web_search","input":{"query":"first query"}},{"type":"web_search_tool_result","tool_use_id":"search-a","content":[{"url":"https://first.example","title":"First","encrypted_content":"opaque-a"}]},{"type":"text","text":"First answer","cache_control":{"type":"ephemeral"},"citations":[{"type":"web_search_result_location","encrypted_index":"opaque-citation-a","url":"https://first.example","title":"First","cited_text":"first excerpt"},{"type":"char_location","document_index":0,"start_char_index":0,"end_char_index":5}]}]},{"role":"assistant","content":[{"type":"server_tool_use","id":"search-b","name":"web_search","input":{"query":"second query"}},{"type":"web_search_tool_result","tool_use_id":"search-b","content":[{"url":"https://second.example","title":"Second","encrypted_content":"opaque-b"}]},{"type":"image","source":{"type":"base64","media_type":"image/png","data":"aW1hZ2U="}},{"type":"tool_use","id":"ordinary-tool","name":"lookup","input":{"key":"x"}},{"type":"tool_result","tool_use_id":"ordinary-tool","content":"ordinary result"},{"type":"server_tool_use","id":"other-server","name":"code_execution","input":{"code":"1+1"}},{"type":"text","text":"Second answer","citations":[{"type":"web_search_result_location","encrypted_index":"opaque-citation-b","url":"https://second.example","title":"Second","cited_text":"second excerpt"},{"type":"char_location","document_index":2,"start_char_index":0,"end_char_index":6}]}]},{"role":"user","content":"followup"}]}`
+
+func TestClaudeSearchGenericRecoveryIgnoresInvalidCoordinatesAcrossTurns(t *testing.T) {
+	body := []byte(genericSearchRecoveryFixture)
+	failure := citationRecoveryFailure("messages.999999999999999999999999.content.888888888888888888888.citations.777: Invalid `encrypted_index` in `text` block")
+	recovered, changed := RecoverClaudeSearchHistory(body, failure)
+	if !changed {
+		t.Fatal("expected all hosted searches in history to recover despite invalid coordinates")
+	}
+	for _, want := range []string{"First answer", "Second answer", "https://first.example", "first excerpt", "https://second.example", "second excerpt"} {
+		if !strings.Contains(string(recovered), want) {
+			t.Errorf("recovered history lost readable content %q", want)
+		}
+	}
+	if strings.Contains(string(recovered), "opaque-") || strings.Contains(string(recovered), `"type":"web_search_tool_result"`) {
+		t.Fatal("recovered history retained encrypted hosted-search metadata")
