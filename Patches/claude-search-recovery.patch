--- /dev/null
+++ b/internal/runtime/executor/helps/claude_search_citation_recovery_test.go
@@ -0,0 +1,142 @@
+package helps
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const citationRecoveryMessage = `{"role":"assistant","content":[{"type":"server_tool_use","id":"srvtoolu_history","name":"web_search","input":{"query":"old search"}},{"type":"web_search_tool_result","tool_use_id":"srvtoolu_history","content":[]},{"type":"text","text":"Original answer","cache_control":{"type":"ephemeral"},"citations":[{"type":"web_search_result_location","encrypted_index":"opaque-citation","url":"https://source.example/a","title":"Source","cited_text":"readable excerpt"},{"type":"char_location","document_index":0,"start_char_index":0,"end_char_index":4}]}]}`
+
+func citationRecoveryFailure(message string) []byte {
+	data, _ := json.Marshal(map[string]any{"error": map[string]string{"type": "invalid_request_error", "message": message}})
+	return data
+}
+
+func TestClaudeCitationRecoveryTargetsOnlyRejectedHistory(t *testing.T) {
+	body := []byte(`{"model":"claude-opus-5-5","system":"untouched", "messages":[{"role":"user","content":"question"},` + citationRecoveryMessage + `,{"role":"user","content":"followup"}]}`)
+	failure := citationRecoveryFailure("messages.29.content.2.citations.0: Invalid `encrypted_index` in `text` block")
+	before := bytes.Clone(body)
+	recovered, changed := RecoverClaudeSearchHistory(body, failure)
+	if !changed {
+		t.Fatal("expected unique matching citation to recover despite renumbered message index")
+	}
+	if !bytes.Equal(body, before) {
+		t.Fatal("modified caller-owned history")
+	}
+	for _, path := range []string{"system", "messages.0", "messages.2", "messages.1.content.2.cache_control"} {
+		if gjson.GetBytes(body, path).Raw != gjson.GetBytes(recovered, path).Raw {
+			t.Fatalf("changed unrelated field %s", path)
+		}
+	}
+	text := gjson.GetBytes(recovered, "messages.1.content.2.text").String()
+	for _, want := range []string{"Original answer", "https://source.example/a", "readable excerpt"} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("lost readable reference %q", want)
+		}
+	}
+	if strings.Contains(string(recovered), "opaque-citation") || strings.Contains(string(recovered), `"web_search_tool_result"`) {
+		t.Fatal("retained unusable native search metadata")
+	}
+	if gjson.GetBytes(recovered, "messages.1.content.2.citations.0.type").String() != "char_location" {
+		t.Fatal("removed non-search citation")
+	}
+	if _, changed := RecoverClaudeSearchHistory(recovered, failure); changed {
+		t.Fatal("already recovered history would retry forever")
+	}
+	shifted, err := sjson.SetRawBytes(body, "messages", []byte(`[{"role":"user","content":"new prefix"},`+gjson.GetBytes(body, "messages").Raw[1:]))
+	if err != nil {
+		t.Fatal(err)
+	}
+	replayed := ApplyClaudeSearchRecovery(WithClaudeSearchRecovery(context.Background(), failure, body), shifted)
+	if gjson.GetBytes(replayed, "messages.2.content.1.type").String() != "text" {
+		t.Fatal("did not follow stable search identity across request rebuilding")
+	}
+}
+
+func TestClaudeCitationOnlyHistoryRecovery(t *testing.T) {
+	body := []byte(`{"messages":[{"role":"assistant","content":[{"type":"text","text":"Answer","citations":[{"type":"web_search_result_location","encrypted_index":"lost-search-index","url":"https://source.example"}]}]}]}`)
+	failure := citationRecoveryFailure("messages.0.content.0.citations.0: Invalid `encrypted_index` in `text` block")
+	ctx := WithClaudeSearchRecovery(context.Background(), failure, body)
+	recovered := ApplyClaudeSearchRecovery(ctx, body)
+	if bytes.Equal(recovered, body) || strings.Contains(string(recovered), "lost-search-index") || !strings.Contains(string(recovered), "https://source.example") {
+		t.Fatalf("citation-only recovery failed: %s", recovered)
+	}
+}
+
+func TestClaudeCitationRecoveryRenumberedIndexPointsAtUnrelatedAssistant(t *testing.T) {
+	messages := make([]json.RawMessage, 885)
+	for i := range messages {
+		messages[i] = json.RawMessage(`{"role":"user","content":"ordinary history"}`)
+	}
+	messages[29] = json.RawMessage(`{"role":"assistant","content":[{"type":"tool_use","id":"call_a","name":"read_file","input":{}},{"type":"tool_use","id":"call_b","name":"read_file","input":{}},{"type":"tool_use","id":"call_c","name":"read_file","input":{}},{"type":"tool_use","id":"call_d","name":"read_file","input":{}}]}`)
+	messages[43] = messages[29]
+	messages[205] = json.RawMessage(`{"role":"assistant","content":[{"type":"thinking","thinking":"first","signature":"preserved"},{"type":"server_tool_use","id":"srvtoolu_first","name":"web_search","input":{"query":"first query"}},{"type":"web_search_tool_result","tool_use_id":"srvtoolu_first","content":[]},{"type":"thinking","thinking":"second","signature":"preserved"},{"type":"text","text":"First answer","citations":[{"type":"web_search_result_location","encrypted_index":"first-index","url":"https://first.example"}]}]}`)
+	messages[219] = json.RawMessage(`{"role":"assistant","content":[{"type":"server_tool_use","id":"srvtoolu_second","name":"web_search","input":{"query":"second query"}},{"type":"web_search_tool_result","tool_use_id":"srvtoolu_second","content":[]},{"type":"thinking","thinking":"third","signature":"preserved"},{"type":"text","text":"Second answer","citations":[{"type":"web_search_result_location","encrypted_index":"second-index","url":"https://second.example"}]}]}`)
+	body, err := json.Marshal(map[string]any{"messages": messages})
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := citationRecoveryFailure("messages.29.content.4.citations.0: Invalid `encrypted_index` in `text` block")
+	second := citationRecoveryFailure("messages.43.content.3.citations.0: Invalid `encrypted_index` in `text` block")
+	recovered, changed := RecoverClaudeSearchHistory(body, first)
+	if !changed {
+		t.Fatal("unrelated assistant at reported wire index prevented unique citation recovery")
+	}
+	ctx := WithClaudeSearchRecovery(context.Background(), first, body)
+	if CanRecoverClaudeSearch(ctx, first) {
+		t.Fatal("same rejection could rewrite a different search on the next retry")
+	}
+	if CanRecoverClaudeSearch(ctx, second) {
+		t.Fatal("another error position authorized more than one corrective retry")
+	}
+	if replayed := ApplyClaudeSearchRecovery(ctx, body); !bytes.Equal(replayed, recovered) {
+		t.Fatal("retry did not apply the same recovery to rebuilt history")
+	}
+	if _, changed := RecoverClaudeSearchHistory(recovered, second); changed {
+		t.Fatal("orphaned history was not repaired together on the first recovery")
+	}
+	if strings.Contains(string(recovered), "first-index") || strings.Contains(string(recovered), "second-index") {
+		t.Fatal("batch recovery retained an orphaned citation")
+	}
+	for i, original := range messages {
+		if i != 205 && i != 219 && gjson.GetBytes(recovered, "messages."+strconv.Itoa(i)).Raw != string(original) {
+			t.Fatalf("changed unrelated message %d", i)
+		}
+	}
+}
+
+func TestClaudeSearchRecoveryRejectsUnrelatedErrors(t *testing.T) {
+	body := []byte(`{"messages":[{"role":"user","content":"question"},` + citationRecoveryMessage + `,{"role":"user","content":"followup"},` + citationRecoveryMessage + `]}`)
+	for _, message := range []string{
+		"messages.1.content.2: Invalid `encrypted_content` in `text` block",
+		"messages.1.content.2.citations.0: Invalid `encrypted_index` in `text` block followed by unrelated data",
+		"unrelated model validation error",
+	} {
+		t.Run(message, func(t *testing.T) {
+			recovered, changed := RecoverClaudeSearchHistory(body, citationRecoveryFailure(message))
+			if changed || !bytes.Equal(body, recovered) {
+				t.Fatal("rewrote history after an unrelated error")
+			}
+		})
+	}
+	// A recognized rejection converts repeated native artifacts without using
+	// their IDs to guess which assistant turn the server meant.
+	failure := citationRecoveryFailure("messages.1.content.2.citations.0: Invalid `encrypted_index` in `text` block")
+	if got := ApplyClaudeSearchRecovery(WithClaudeSearchRecovery(context.Background(), failure, body), body); bytes.Equal(got, body) || strings.Contains(string(got), "opaque-citation") {
+		t.Fatal("recovery did not render repeated hosted search artifacts")
+	}
+}
+
+func TestClaudeSearchRecoveryRecognizesUniqueDecryptError(t *testing.T) {
+	body := []byte(`{"messages":[` + citationRecoveryMessage + `]}`)
+	if _, changed := RecoverClaudeSearchHistory(body, citationRecoveryFailure("Failed to decrypt web search result content")); !changed {
+		t.Fatal("did not recover uniquely identifiable encrypted search history")
+	}
+}
diff --git a/internal/runtime/executor/helps/claude_search_generic_recovery_test.go b/internal/runtime/executor/helps/claude_search_generic_recovery_test.go
