+func TestClaudeSearchRecoveryHandlesDuplicateIdentityAndAllowsOneCorrectiveRetry(t *testing.T) {
+	base := []byte(orphanedRecoveryFixture)
+	// Repeated identities must not prevent rendering both copies during a rebuild.
+	message := gjson.GetBytes(base, "messages.0").Raw
+	duplicate, err := sjson.SetRawBytes(base, "messages", []byte(`[ `+message+`,`+gjson.GetBytes(base, "messages").Raw[1:]))
+	if err != nil {
+		t.Fatal(err)
+	}
+	failure := citationRecoveryFailure("messages.99.content.1.citations.0: Invalid `encrypted_index` in `text` block")
+	ctx := WithClaudeSearchRecovery(context.Background(), failure, duplicate)
+	// Applying a context without a recorded rejection must preserve exact bytes.
+	if got := ApplyClaudeSearchRecovery(context.Background(), duplicate); !bytes.Equal(got, duplicate) {
+		t.Fatal("unmarked context changed request bytes")
+	}
+	recovered := ApplyClaudeSearchRecovery(ctx, duplicate)
+	for _, token := range []string{"opaque-one", "opaque-two", "opaque-native", "keep encrypted bytes", `"web_search_tool_result"`, `"server_tool_use"`} {
+		if strings.Contains(string(recovered), token) {
+			t.Fatalf("duplicate identities prevented recovery of %q", token)
