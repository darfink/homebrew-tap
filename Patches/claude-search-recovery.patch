+	}
+	if !CanRecoverClaudeSearch(context.Background(), failure) {
+		t.Fatal("expected first rejection to be eligible")
+	}
+	for _, position := range []string{"messages.0.content.0: Invalid `encrypted_index` in `text` block", "messages.88.content.7: Invalid `encrypted_index` in `text` block"} {
+		if CanRecoverClaudeSearch(ctx, citationRecoveryFailure(position)) {
+			t.Fatalf("second rejection at %q authorized another corrective retry", position)
