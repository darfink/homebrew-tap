diff --git a/internal/runtime/executor/claude_search_captured_recovery_test.go b/internal/runtime/executor/claude_search_captured_recovery_test.go
new file mode 100644
index 00000000..c6b2c198
--- /dev/null
+++ b/internal/runtime/executor/claude_search_captured_recovery_test.go
@@ -0,0 +1,160 @@
+package executor
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// Opt-in replay keeps private captures out of source control. All inference is
+// replaced by an offline HTTP server; no recorded headers or credentials are used.
+func TestClaudeSearchRecoveryCapturedLog(t *testing.T) {
+	path := os.Getenv("CLIPROXY_SEARCH_REPLAY_LOG")
+	if path == "" {
+		t.Skip("set CLIPROXY_SEARCH_REPLAY_LOG to replay a local error capture offline")
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	scanner := bufio.NewScanner(f)
+	scanner.Buffer(make([]byte, 64<<10), 64<<20)
+	var captured []byte
+	var rejection string
+	for scanner.Scan() {
+		line := scanner.Bytes()
+		if !gjson.ValidBytes(line) {
+			continue
+		}
+		if captured == nil && gjson.GetBytes(line, "messages").IsArray() {
+			captured = bytes.Clone(line)
+		}
+		if message := gjson.GetBytes(line, "error.message").String(); rejection == "" && strings.Contains(message, "Invalid `encrypted_index`") {
+			rejection = message
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		t.Fatal(err)
+	}
+	var reported, block, citation int
+	if _, err := fmt.Sscanf(rejection, "messages.%d.content.%d.citations.%d:", &reported, &block, &citation); err != nil {
+		t.Fatal("capture does not contain an indexed citation rejection")
+	}
+	type target struct{ message, block int }
+	var targets []target
+	for i, message := range gjson.GetBytes(captured, "messages").Array() {
+		complete := false
+		for _, part := range message.Get("content").Array() {
+			if part.Get("type").String() == "web_search_tool_result" {
+				for _, result := range part.Get("content").Array() {
+					complete = complete || result.Get("encrypted_content").String() != ""
+				}
+			}
+		}
+		if complete {
+			continue
+		}
+		for j, part := range message.Get("content").Array() {
+			if part.Get("type").String() == "text" && part.Get("citations.0.encrypted_index").String() != "" {
+				targets = append(targets, target{i, j})
+				break
+			}
+		}
+	}
+	if len(targets) == 0 || targets[0].block != block || citation != 0 {
+		t.Fatal("capture needs orphaned citation history with the first indexed citation rejected")
+	}
+	offset := targets[0].message - reported
+	for _, stream := range []bool{false, true} {
+		t.Run(fmt.Sprintf("stream=%v", stream), func(t *testing.T) {
+			attempts := 0
+			var originalMessages []gjson.Result
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				messages := gjson.GetBytes(body, "messages").Array()
+				if attempts == 0 {
+					originalMessages = messages
+				}
+				for i, message := range messages {
+					changed := false
+					for _, target := range targets {
+						changed = changed || (attempts > 0 && i == target.message)
+					}
+					if !changed && message.Raw != originalMessages[i].Raw {
+						t.Errorf("modified unrelated message %d", i)
+					}
+				}
+				pending := -1
+				for i, target := range targets {
+					hasCitation := messages[target.message].Get(fmt.Sprintf("content.%d.citations.0.encrypted_index", target.block)).Exists()
+					if hasCitation != (attempts == 0) {
+						t.Errorf("incorrect batch recovery at target %d attempt %d", i, attempts+1)
+					}
+					if hasCitation && pending < 0 {
+						pending = i
+					}
+				}
+				attempts++
+				if pending >= 0 {
+					target := targets[pending]
+					w.WriteHeader(http.StatusBadRequest)
+					_ = json.NewEncoder(w).Encode(map[string]any{"error": map[string]string{"type": "invalid_request_error", "message": fmt.Sprintf("messages.%d.content.%d.citations.0: Invalid `encrypted_index` in `text` block", target.message-offset, target.block)}})
+					return
+				}
+				if stream {
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = io.WriteString(w, searchRecoverySuccessStream)
+				} else {
+					_, _ = io.WriteString(w, `{"id":"msg_recovered","type":"message","role":"assistant","model":"claude-opus-5-5","content":[{"type":"text","text":"Continued"}],"stop_reason":"end_turn","usage":{"input_tokens":1,"output_tokens":1}}`)
+				}
+			}))
+			defer server.Close()
+			payload, err := sjson.SetBytes(captured, "stream", stream)
+			if err != nil {
+				t.Fatal(err)
+			}
+			before := bytes.Clone(payload)
+			auth := &cliproxyauth.Auth{ID: "offline-account", Provider: "claude", Attributes: map[string]string{"api_key": "synthetic-account", "base_url": server.URL}}
+			executor := NewClaudeExecutor(&config.Config{})
+			req := cliproxyexecutor.Request{Model: gjson.GetBytes(payload, "model").String(), Payload: payload}
+			opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude}
+			if stream {
+				response, err := executor.ExecuteStream(context.Background(), auth, req, opts)
+				if err != nil {
+					t.Fatal(err)
+				}
+				for chunk := range response.Chunks {
+					if chunk.Err != nil {
+						t.Fatal(chunk.Err)
+					}
+				}
+			} else if _, err := executor.Execute(context.Background(), auth, req, opts); err != nil {
+				t.Fatal(err)
+			}
+			if attempts != 2 || !bytes.Equal(payload, before) {
+				t.Fatal("incorrect attempt count or mutated caller history")
+			}
+			t.Logf("full capture: messages=%d recovered_turns=%d attempts=%d; other message bytes unchanged", len(originalMessages), len(targets), attempts)
+		})
+	}
+}
diff --git a/internal/runtime/executor/claude_search_normalized_recovery_test.go b/internal/runtime/executor/claude_search_normalized_recovery_test.go
new file mode 100644
index 00000000..771c4a24
--- /dev/null
+++ b/internal/runtime/executor/claude_search_normalized_recovery_test.go
@@ -0,0 +1,138 @@
+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+func nativeClaudeNormalizedRecoveryPayload(t *testing.T) []byte {
+	t.Helper()
+	messages := make([]json.RawMessage, 225)
+	for i := range messages {
+		messages[i] = json.RawMessage(fmt.Sprintf(`{"role":"user","content":"ordinary history %d"}`, i))
+	}
+	messages[2] = json.RawMessage(`{"role":"user","content":[{"type":"text","text":"Keep this question"},{"type":"image","source":{"type":"base64","media_type":"image/png","data":"c3ludGhldGljLWltYWdl"}}]}`)
+	messages[29] = json.RawMessage(`{"role":"assistant","content":[{"type":"text","text":"Unrelated assistant turn"},{"type":"tool_use","id":"call-history","name":"lookup","input":{"key":"preserve-me"}}]}`)
+	messages[30] = json.RawMessage(`{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-history","content":"tool data preserve-me"}]}`)
+	messages[43] = json.RawMessage(`{"role":"assistant","content":[{"type":"text","text":"Another unrelated assistant turn"},{"type":"tool_use","id":"call-other","name":"lookup","input":{"key":"other-preserve-me"}}]}`)
+	messages[44] = json.RawMessage(`{"role":"user","content":[{"type":"tool_result","tool_use_id":"call-other","content":"other tool data preserve-me"}]}`)
+	// Text padding preserves the captured block positions without forging
+	// thinking signatures that the normal preparation pipeline must discard.
+	messages[205] = json.RawMessage(`{"role":"assistant","content":[{"type":"text","text":"first preserved context"},{"type":"server_tool_use","id":"srvtoolu_first","name":"web_search","input":{"query":"first query"}},{"type":"web_search_tool_result","tool_use_id":"srvtoolu_first","content":[]},{"type":"text","text":"second preserved context"},{"type":"text","text":"First answer cites a source","citations":[{"type":"web_search_result_location","encrypted_index":"opaque-first-index","url":"https://source.example/first","title":"First source","cited_text":"First readable excerpt"}]}]}`)
+	messages[219] = json.RawMessage(`{"role":"assistant","content":[{"type":"server_tool_use","id":"srvtoolu_second","name":"web_search","input":{"query":"second query"}},{"type":"web_search_tool_result","tool_use_id":"srvtoolu_second","content":[]},{"type":"text","text":"third preserved context"},{"type":"text","text":"Second answer cites a source","citations":[{"type":"web_search_result_location","encrypted_index":"opaque-second-index","url":"https://source.example/second","title":"Second source","cited_text":"Second readable excerpt"}]}]}`)
+	// A newer complete search deliberately repeats the first orphan's layout.
+	// Selecting a rejected turn by block shape alone becomes ambiguous here.
+	messages[223] = json.RawMessage(`{"role":"assistant","content":[{"type":"text","text":"recent preserved context"},{"type":"server_tool_use","id":"srvtoolu_complete","name":"web_search","input":{"query":"recent query"}},{"type":"web_search_tool_result","tool_use_id":"srvtoolu_complete","content":[{"type":"web_search_result","url":"https://source.example/recent","encrypted_content":"keep-native-result"}]},{"type":"text","text":"recent second context"},{"type":"text","text":"Recent cited answer","citations":[{"type":"web_search_result_location","encrypted_index":"keep-native-citation","url":"https://source.example/recent"}]}]}`)
+	payload, err := json.Marshal(map[string]any{"model": "claude-opus-5-5", "max_tokens": 256, "thinking": map[string]any{"type": "adaptive"}, "system": "caller-system-preserve-me", "messages": messages})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return payload
+}
+
+func TestClaudeNormalizedCitationRecoveryExecuteAndStream(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		t.Run(fmt.Sprintf("stream=%v", stream), func(t *testing.T) {
+			payload := nativeClaudeNormalizedRecoveryPayload(t)
+			captured := make([][]byte, 0, 3)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				body, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Errorf("read request: %v", err)
+					w.WriteHeader(http.StatusInternalServerError)
+					return
+				}
+				captured = append(captured, body)
+				firstPending := strings.Contains(string(body), "opaque-first-index")
+				secondPending := strings.Contains(string(body), "opaque-second-index")
+				if firstPending || secondPending {
+					w.Header().Set("Content-Type", "application/json")
+					w.WriteHeader(http.StatusBadRequest)
+					path := "messages.29.content.4"
+					if !firstPending {
+						path = "messages.43.content.3"
+					}
+					_, _ = fmt.Fprintf(w, `{"type":"error","error":{"type":"invalid_request_error","message":"%s.citations.0: Invalid `+"`encrypted_index`"+` in `+"`text`"+` block"}}`, path)
+					return
+				}
+				if stream {
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = io.WriteString(w, searchRecoverySuccessStream)
+					return
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = io.WriteString(w, `{"id":"msg_done","type":"message","role":"assistant","model":"claude-opus-5-5","content":[{"type":"text","text":"Continued"}],"stop_reason":"end_turn","usage":{"input_tokens":5,"output_tokens":1}}`)
+			}))
+			defer server.Close()
+
+			auth := &cliproxyauth.Auth{ID: "synthetic-account", Provider: "claude", Attributes: map[string]string{"api_key": "synthetic-account", "base_url": server.URL}}
+			req := cliproxyexecutor.Request{Model: "claude-opus-5-5", Payload: payload}
+			opts := cliproxyexecutor.Options{Stream: stream, SourceFormat: sdktranslator.FormatClaude, OriginalRequest: payload}
+			var output []byte
+			if stream {
+				response, err := NewClaudeExecutor(nil).ExecuteStream(context.Background(), auth, req, opts)
+				if err != nil {
+					t.Fatalf("ExecuteStream: %v", err)
+				}
+				for chunk := range response.Chunks {
+					if chunk.Err != nil {
+						t.Fatalf("stream chunk: %v", chunk.Err)
+					}
+					output = append(output, chunk.Payload...)
+				}
+			} else {
+				response, err := NewClaudeExecutor(nil).Execute(context.Background(), auth, req, opts)
+				if err != nil {
+					t.Fatalf("Execute: %v", err)
+				}
+				output = response.Payload
+			}
+			if len(captured) != 2 || !strings.Contains(string(output), "Continued") {
+				t.Fatalf("attempts=%d output=%s", len(captured), output)
+			}
+			if string(req.Payload) != string(payload) || string(opts.OriginalRequest) != string(payload) {
+				t.Fatal("mutated caller-owned payload")
+			}
+			assertRejectedCitationRecoveryRequest(t, captured[0], true, true)
+			assertRejectedCitationRecoveryRequest(t, captured[1], false, false)
+			for i, message := range gjson.GetBytes(captured[0], "messages").Array() {
+				if i != 205 && i != 219 && message.Raw != gjson.GetBytes(captured[1], fmt.Sprintf("messages.%d", i)).Raw {
+					t.Errorf("changed unrelated message %d, including complete search history", i)
+				}
+			}
+		})
+	}
+}
+
+func assertRejectedCitationRecoveryRequest(t *testing.T, body []byte, firstSearchNative, secondSearchNative bool) {
+	t.Helper()
+	for _, check := range []struct {
+		marker string
+		want   bool
+	}{
+		{"opaque-first-index", firstSearchNative},
+		{"srvtoolu_first", firstSearchNative},
+		{"opaque-second-index", secondSearchNative},
+		{"srvtoolu_second", secondSearchNative},
+	} {
+		if got := strings.Contains(string(body), check.marker); got != check.want {
+			t.Errorf("%q present=%v, want %v", check.marker, got, check.want)
+		}
+	}
+	for _, want := range []string{"ordinary history 100", "caller-system-preserve-me", "c3ludGhldGljLWltYWdl", "call-history", "preserve-me", "https://source.example/first", "First readable excerpt", "https://source.example/second", "Second readable excerpt"} {
+		if !strings.Contains(string(body), want) {
+			t.Errorf("request lost preserved content %q", want)
+		}
+	}
+}
diff --git a/internal/runtime/executor/claude_search_recovery_test.go b/internal/runtime/executor/claude_search_recovery_test.go
