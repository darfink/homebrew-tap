+		t.Fatal("expected recognized rejection to recover all assistant search references")
+	}
+	for _, secret := range []string{"opaque-one", "opaque-two", "opaque-native", "keep encrypted bytes", `"web_search_tool_result"`, `"server_tool_use"`} {
